# Copiá este archivo como .env y completá con los datos de tu proyecto de Firebase
# (Firebase Console → Configuración del proyecto → Tus apps → SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional: un correo para que MyMemory (el traductor del buscador de recetas)
# permita traducir más texto por día. Si lo dejás vacío, funciona igual.
VITE_MYMEMORY_EMAIL=
